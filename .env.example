# Variables de entorno para el Frontend Mil Sabores
# Copiar a .env.local (misma carpeta) y reiniciar `npm run dev` tras cambiar valores.

# --- Azure Entra ID (MSAL) — mismos IDs que en Azure Portal ---
VITE_AZURE_TENANT_ID=tu-tenant-id-aqui
VITE_AZURE_CLIENT_ID=tu-client-id-aqui
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/tu-tenant-id-aqui

# Scope de la API expuesta en Entra (App Registration "API" → Expose an API → access_as_user)
VITE_AZURE_API_SCOPE=api://tu-client-id-api-o-misma-app/access_as_user

# --- Backend local EP1: todo pasa por API Gateway ---
VITE_API_GATEWAY_URL=http://localhost:8080/api

# Solo si NO usas gateway (no recomendado para EP1):
# VITE_USUARIO_API_URL=http://localhost:8081/api
# VITE_PRODUCTO_API_URL=http://localhost:8082/api
# VITE_CARRITO_API_URL=http://localhost:8083/api
# VITE_VENTAS_API_URL=http://localhost:8084/api

# --- Producción (Vercel) ---
# VITE_AZURE_* + Redirect URI de Vercel en Azure
# VITE_API_GATEWAY_URL=https://tu-api-gateway.onrender.com/api
